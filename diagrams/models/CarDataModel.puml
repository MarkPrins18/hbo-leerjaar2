@startuml CarDataModel

package models {

    enum FuelType {
        PETROL
        DIESEL
        LPG
    }

    enum VehicleType {
        PASSENGER_CAR
        LIGHT_COMMERCIAL_VEHICLE
    }

    abstract class Car <<sealed>> {
        +id: Int
        +ownerId: Int
        +licensePlate: String
        +brand: String
        +model: String
        +productionYear: Int
        +trim: String?
        +color: String
        +seats: Int
        +doors: Int?
        +vehicleType: VehicleType
        +readyToDriveWeightKg: Int
        +consumptionCombined: Double
        +co2EmissionCombined: Double
    }

    class ICECar <<data>> {
        +fuelType: FuelType
        +tankCapacityL: Double
        +automaticTransmission: Boolean
    }

    class BEVCar <<data>> {
        +batteryCapacityKWh: Double
    }

    class FCEVCar <<data>> {
        +tankCapacityKgH2: Double
    }

    Car <|-- ICECar
    Car <|-- BEVCar
    Car <|-- FCEVCar

    enum ReservationStatus {
        PENDING
        CONFIRMED
        CANCELLED
        COMPLETED
    }

    enum RideStatus {
        IN_PROGRESS
        COMPLETED
    }

    class User <<data>> {
        +id: Int
        +email: String
        +passwordHash: String
    }

    class Reservation <<data>> {
        +id: Int
        +carId: Int
        +userId: Int
        +startTime: Instant
        +endTime: Instant
        +status: ReservationStatus
    }

    class Ride <<data>> {
        +id: Int
        +reservationId: Int
        +startTime: Instant
        +endTime: Instant?
        +status: RideStatus
        +distanceM: Double?
        +avgAcceleration: Double?
        +avgDeceleration: Double?
        +bonusPoints: Int?
    }

    Car --> VehicleType
    ICECar --> FuelType

    Reservation --> ReservationStatus
    Ride --> RideStatus
    Car "*" --> "1" User : ownerId
    Reservation "*" --> "1" User : userId
    Reservation "*" --> "1" Car : carId
    Ride "*" --> "1" Reservation : reservationId
}

@enduml