@startuml CarDataModel

package shared.models {

    enum FuelType {
        PETROL
        DIESEL
        LPG
    }

    enum VehicleType {
        PASSENGER_CAR
        LIGHT_COMMERCIAL_VEHICLE
    }

    abstract class Car <<sealed>> {
        +id: Int
        +userId: Int
        +licensePlate: String
        +brand: String
        +model: String
        +productionYear: Int
        +trim: String?
        +color: String
        +seats: Int?
        +doors: Int?
        +vehicleType: VehicleType
        +readyToDriveWeightKg: Int
        +consumptionCombined: Double?
        +co2EmissionCombined: Double?
        +roadTaxPerQuarter: Double?
    }

    class ICECar <<data>> {
        +fuelType: FuelType
        +tankCapacityL: Double
        +automaticTransmission: Boolean
    }

    class BEVCar <<data>> {
        +batteryCapacityKWh: Double
    }

    class FCEVCar <<data>> {
        +tankCapacityKgH2: Double
    }

    class RentalTerms <<data>> {
        +id: Int
        +carId: Int
        +pricePerDay: Double
        +pickupLocation: String
        +pickupTimeStart: LocalTime?
        +pickupTimeEnd: LocalTime?
        +returnLocation: String?
        +returnTimeStart: LocalTime?
        +returnTimeEnd: LocalTime?
    }

    class Photo <<data>> {
        +id: Int
        +carId: Int
        +url: String
        +uploadedAt: Instant
    }

    Car "1" <-- "0..1" RentalTerms
    Car "1" <-- "*" Photo

    Car <|-- ICECar
    Car <|-- BEVCar
    Car <|-- FCEVCar

    enum ReservationStatus {
        PENDING
        CONFIRMED
        CANCELLED
        COMPLETED
    }

    enum RideStatus {
        IN_PROGRESS
        COMPLETED
    }

    class Reservation <<data>> {
        +id: Int
        +carId: Int
        +userId: Int
        +startTime: Instant
        +endTime: Instant
        +status: ReservationStatus
        +totalPrice: Double
    }

    class Ride <<data>> {
        +id: Int
        +reservationId: Int
        +startTime: Instant
        +endTime: Instant?
        +status: RideStatus
        +distanceM: Double?
        +avgAcceleration: Double?
        +avgDeceleration: Double?
        +bonusPoints: Int?
    }
}

package models {

    class User <<data>> {
        +id: Int
        +email: String
        +passwordHash: String
    }

    class Location <<data>> {
        +id: Int
        +carId: Int
        +userId: Int?
        +rideId: Int?
        +latitude: Double
        +longitude: Double
        +speed: Double?
        +timestamp: Instant
    }
}

Car --> VehicleType
ICECar --> FuelType

Reservation --> ReservationStatus
Ride --> RideStatus
Car "*" --> "1" User : userId
Reservation "*" --> "1" User : userId
Reservation "*" --> "1" Car : carId
Ride "*" --> "1" Reservation : reservationId
Location "*" --> "1" Car : carId
Location "*" --> "0..1" User : userId
Location "*" --> "0..1" Ride : rideId

@enduml