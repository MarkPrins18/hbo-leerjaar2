@startuml FinishRide
title Sequentiediagram #12: rit afronden (PATCH /rides/{id}/finish)

actor Huurder as g
participant "Android-app" as app
participant "rideRoutes" as rt
participant "RideService" as svc
participant "RideRepository" as riderepo
participant "ReservationRepository" as resrepo
database "H2-database" as db

g -> app : rit beëindigen()
app -> rt : PATCH /rides/{id}/finish {distanceM, avgAcceleration, avgDeceleration,\nlatitude, longitude}\nAuthorization: Bearer <token>
note right of rt
  requireAuthentication { }: zonder geldig token
  stopt de request hier met 401 (preconditie: #2)
end note
rt -> rt : call.authenticatedUserId()
rt -> svc : finishRide(rideId, userId, request)
svc -> svc : distanceM, avgAcceleration en\navgDeceleration niet negatief,\ndistanceM <= 6000 km?
svc -> svc : validateCoordinates(latitude, longitude)\n-90..90 en -180..180, geen NaN?

group flow 7a [negatieve waarde, afstand boven 6000 km of ongeldige coördinaten]
    svc --> rt : throw ValidationException
    rt --> app : 400 Bad Request (StatusPages)
    app --> g : foutmelding (stap 6)
end

svc -> riderepo : getRideById(rideId)
riderepo -> db : SELECT FROM ride WHERE id
db --> riderepo : 0 of 1 rij
riderepo --> svc : Ride?

group flow 8a [rit bestaat niet]
    svc --> rt : throw ResourceNotFoundException
    rt --> app : 404 Not Found (StatusPages)
    app --> g : foutmelding (einde)
end

svc -> resrepo : getReservationById(ride.reservationId)
resrepo -> db : SELECT FROM reservation WHERE id
db --> resrepo : 1 rij
resrepo --> svc : Reservation

group flow 8b [rit hoort bij een reservering van een andere gebruiker]
    svc --> rt : throw ForbiddenException
    rt --> app : 403 Forbidden (StatusPages)
    app --> g : foutmelding (einde)
end

group flow 8c [rit is al afgerond]
    svc --> rt : throw ConflictException
    rt --> app : 409 Conflict (StatusPages)
    app --> g : foutmelding (einde)
end

svc -> svc : calculateBonusPoints(distanceM,\navgAcceleration, avgDeceleration)
svc -> riderepo : finishRide(rideId, nu, request, bonusPoints)
note right of riderepo
  Alles hieronder in één suspendTransaction:
  lukt een stap niet, dan wordt niets opgeslagen.
end note
riderepo -> db : UPDATE ride (COMPLETED)\nWHERE id AND status = IN_PROGRESS
db --> riderepo : aantal bijgewerkte rijen

group flow 9a [rit is intussen al afgerond (0 rijen bijgewerkt)]
    riderepo --> svc : null
    svc --> rt : throw ConflictException
    rt --> app : 409 Conflict (StatusPages)
    app --> g : foutmelding (einde)
end

riderepo -> db : SELECT van de rij
db --> riderepo : 1 rij
riderepo -> db : SELECT car_id FROM reservation WHERE id
db --> riderepo : car_id
riderepo -> db : UPDATE reservation SET status = COMPLETED\nWHERE id = ride.reservationId
note right of db
  Op een COMPLETED reservering start geen
  nieuwe rit meer (409) en annuleren geeft 409.
end note

riderepo -> db : INSERT INTO location\n(car_id, latitude, longitude, speed = 0, nu)
note right of db
  De nieuwste rij geldt als huidige locatie
  (getLatestLocationByCarId).
end note
riderepo --> svc : Ride

svc --> rt : Ride
rt --> app : 200 OK + Ride
app --> g : toont bonuspunten, reservering is afgerond

@enduml
