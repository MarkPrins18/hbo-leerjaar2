@startuml ReserveCar
title Sequentiediagram #9: auto reserveren (POST /reservations)

actor Huurder as g
participant "Android-app" as app
participant "reservationRoutes" as rt
participant "ReservationService" as svc
participant "CarRepository" as car
participant "UserRepository" as user
participant "RentalTermsRepository" as terms
participant "ReservationRepository" as repo
database "H2-database" as db

g -> app : reserveer()
app -> rt : POST /reservations {carId, startTime, endTime}\nAuthorization: Bearer <token>
note right of rt
  requireAuthentication { }: zonder geldig token
  stopt de request hier met 401 (preconditie: #2)
end note
rt -> rt : call.authenticatedUserId()
rt -> svc : createReservation(userId, request)
svc -> svc : startTime > nu en endTime > startTime?

group flow 3a [starttijd in het verleden of eindtijd niet na starttijd]
    svc --> rt : throw ValidationException
    rt --> app : 400 Bad Request (StatusPages)
    app --> g : foutmelding (stap 1)
end

svc -> car : getCarById(carId)
car -> db : SELECT car + subtabellen WHERE id
db --> car : 0 of 1 rij
car --> svc : Car?

group flow 4a [auto bestaat niet]
    svc --> rt : throw ResourceNotFoundException
    rt --> app : 404 Not Found (StatusPages)
    app --> g : foutmelding (einde)
end

group flow 4b [huurder is de eigenaar van de auto]
    svc --> rt : throw ForbiddenException
    rt --> app : 403 Forbidden (StatusPages)
    app --> g : eigen auto kan niet (einde)
end

svc -> user : userExists(userId)
user -> db : SELECT FROM users WHERE id
db --> user : 0 of 1 rij
user --> svc : Boolean

group flow 4c [huurder bestaat niet]
    svc --> rt : throw ResourceNotFoundException
    rt --> app : 404 Not Found (StatusPages)
    app --> g : foutmelding (einde)
end

svc -> terms : getRentalTermsByCarId(carId)
terms -> db : SELECT FROM rental_terms WHERE car_id
db --> terms : 0 of 1 rij
terms --> svc : RentalTerms?

group flow 4d [auto heeft nog geen huurvoorwaarden]
    svc --> rt : throw UnprocessableException
    rt --> app : 422 Unprocessable Entity (StatusPages)
    app --> g : auto is nog niet te huur (einde)
end

svc -> svc : calculateTotalPrice(pricePerDay, startTime, endTime)
note right of svc
  pricePerDay × begonnen dagen:
  ceil(duur / 24 uur), minimaal 1,
  afgerond op centen
end note

svc -> repo : createReservationIfAvailable(carId, userId, ..., CONFIRMED, totalPrice)
note right of repo
  Eén transactie: de auto-rij wordt vergrendeld,
  zodat twee gelijktijdige reserveringen elkaar
  niet missen bij de overlapcontrole.
end note
repo -> db : SELECT FROM car WHERE id FOR UPDATE
repo -> db : SELECT FROM reservation (actief + overlap)
db --> repo : rijen

group flow 5a [tijdsblok overlapt met actieve reservering]
    repo --> svc : null
    svc --> rt : throw ConflictException
    rt --> app : 409 Conflict (StatusPages)
    app --> g : ander tijdsblok (stap 1)
end

repo -> db : INSERT INTO reservation
db --> repo : id, daarna SELECT van de nieuwe rij
repo --> svc : Reservation
svc --> rt : Reservation
rt --> app : 201 Created + Reservation (met totalPrice)
app --> g : toont bevestiging en prijs

@enduml
