' Shared phone frame for all wireframes (reference: Samsung Galaxy S26, portrait, ~360x800 dp, 20:9).
' Usage inside the outer {+ block:
'   $phone_top("Title", %true())     back arrow, %false() for a tab root screen
'   ... content ...
'   $phone_bottom("Ritten")          active tab: Ritten, Zoeken or Account; "" = no bottom navigation
'
' Fixed sizes keep every screen 362 x 803 px with aligned columns:
'   Salt sizes fields and buttons by character count (8 px per character, spaces included).
'   label/value grid : first label padded with $hs(..) to a 144 px label column, fields of 23 characters
'   full width       : fields and buttons of 41 characters (332 px)
'   card ({+ ... })  : title padded with $hs(..) to 330 px
'   content taller than the screen does not fit: shorten it or add a "scrollt verder" note
'
' Building blocks (cards, photos, carousel, password field, lists, stat tiles, chips, popups and
' several phones side by side) are documented at their definition below the phone frame.

!$frame_width = 360
!$content_height = 476
!$nav_height = 47

' Invisible horizontal spacer of $px pixels (em spaces at font size 1).
!function $hs($px)
!$s = ""
!$i = 0
!while $i < $px
!$s = $s + "<U+2003>"
!$i = $i + 1
!endwhile
!return "<size:1>" + $s + "</size>"
!endfunction

!procedure $phone_top($title, $back)
{ $hs(14)12:30 | $hs(226) | <&signal> <&wifi> <&battery-full> 100% }
.
!if $back
{ $hs(14)<size:18>← | <size:18>$title }
!else
{ $hs(14)<size:18>$title }
!endif
==
{
$hs(10)<size:$content_height><U+200B></size> | {
!endprocedure

!procedure $phone_bottom($active)
}
}
!if $active != ""
--
{
$hs(50)<&list*2> | $hs(50)<&magnifying-glass*2> | $hs(50)<&person*2>
!if $active == "Ritten"
$hs(42)<b>Ritten | $hs(38)Zoeken | $hs(36)Account
!elseif $active == "Zoeken"
$hs(44)Ritten | $hs(38)<b>Zoeken | $hs(36)Account
!else
$hs(44)Ritten | $hs(38)Zoeken | $hs(34)<b>Account
!endif
$hs(118) | $hs(118) | $hs(118)
}
!else
<size:$nav_height><U+200B></size>
!endif
{ $hs(130) | {+ $hs(96) } }
$hs($frame_width)
!endprocedure

' ============================================================================
' Building blocks (neutral grey/black/white). Widths assume the content column of one phone (332 px).
' Procedures go on their own line inside the content; functions ($xxx(..) returning text) go inline.
' ============================================================================

!$card_width = 330
!$grey_icon = "#A0A0A0"
!$muted = "#666666"

' $pad(text, n): text followed by spaces up to n characters, for input fields: "$pad("abc", 41)"
!function $pad($text, $n)
!$s = $text
!while %strlen($s) < $n
!$s = $s + " "
!endwhile
!return $s
!endfunction

' --- Text helpers (functions, inline) ----------------------------------------
' $section("Beschikbare auto's")   small grey caps section header (own line, above a card or list)
!function $section($text)
!return "<size:11><color:" + $muted + "><b>" + %upper($text) + "</b></color></size>"
!endfunction

' $muted_text("2,4 km")            secondary text in grey
!function $muted_text($text)
!return "<color:" + $muted + ">" + $text + "</color>"
!endfunction

' $note("tik op een auto: S02")    italic grey designer note (not part of the UI)
!function $note($text)
!return "<i><color:#888888>" + $text + "</color></i>"
!endfunction

' $chip("In afwachting")           neutral status chip/badge
' $chip_dark("Bevestigd")          emphasized chip (dark background, white text)
!function $chip($text)
!return "<back:#E3E3E3><size:11><U+2002>" + $text + "<U+2002></size></back>"
!endfunction

!function $chip_dark($text)
!return "<back:#444444><color:#FFFFFF><size:11><U+2002>" + $text + "<U+2002></size></color></back>"
!endfunction

' $link("Wachtwoord vergeten?")    underlined text link
!function $link($text)
!return "<u>" + $text + "</u>"
!endfunction

' --- Photos -------------------------------------------------------------------
' $photo_thumb()                   square framed thumbnail (~66 px) with a picture icon, inline as a cell
!function $photo_thumb()
!return "{+ <color:" + $grey_icon + "><&image*8></color> }"
!endfunction

' $photo_large("Foto")             framed photo area, full content width (330 px), ~180 px high,
'                                  centered picture icon + caption below it ("" = no caption)
!procedure $photo_large($caption)
{+
  <size:16><U+200B></size>
  $hs(109)<color:$grey_icon><&image*14></color>
  { $hs(150) | <color:$muted>$caption }
  $hs($card_width)
}
!endprocedure

' $carousel(1, 3)                  photo carousel: large photo area with ‹ › arrows at the sides,
'                                  page dots (● ○ ○) and "1/3"; $page = current (1-based), $total = 1..6
!procedure $carousel($page, $total)
!$dots = ""
!$i = 1
!while $i <= $total
!if $i == $page
!$dots = $dots + "●"
!else
!$dots = $dots + "○"
!endif
!if $i < $total
!$dots = $dots + " "
!endif
!$i = $i + 1
!endwhile
{+
  {
    {
      <size:64><U+200B></size>
      $hs(4)<size:26><b>‹</b></size>
    } | {
      <size:16><U+200B></size>
      $hs(88)<color:$grey_icon><&image*14></color>
    } | {
      <size:64><U+200B></size>
      $hs(92)<size:26><b>›</b></size>
    }
  }
  { $hs(140)<size:14>$dots</size> | $hs(80)<color:$muted>$page/$total }
  $hs($card_width)
}
!endprocedure

' --- Cards --------------------------------------------------------------------
' $card_begin("Huurvoorwaarden") ... $card_end()
'     framed card of full content width: bold title + subtle separator, then your own lines/grids.
'     $card_begin("") = no title row (write your own, e.g. "{ <b>Toyota Yaris | $chip("Bevestigd") }").
!procedure $card_begin($title)
{+
!if $title != ""
  <size:14><b>$title</b></size>
  ..
!endif
!endprocedure

!procedure $card_end()
  $hs($card_width)
}
!endprocedure

' $card_photo_begin() ... $card_photo_end()
'     list card with $photo_thumb() on the left; the lines in between form the right-hand column.
!procedure $card_photo_begin()
{+
  { $photo_thumb() | $hs(2) | {
!endprocedure

!procedure $card_photo_end()
  } }
  $hs($card_width)
}
!endprocedure

' --- Form controls ----------------------------------------------------------
' $password_field(%false())        full-width (332 px) password field with eye toggle at the right end;
'                                  %false() = hidden (dots, grey eye), %true() = visible (shows $value, black eye)
'                                  $value is optional: $password_field(%true(), "Geheim123")
!procedure $password_field($visible, $value="Geheim123!")
!if $visible
{ "$pad($value, 39)" | {
  <size:2><U+200B></size>
  <size:15><&eye></size>
} }
!else
{ "$pad("••••••••••", 39)" | {
  <size:2><U+200B></size>
  <size:15><color:#999999><&eye></color></size>
} }
!endif
!endprocedure

' --- Lists: menu rows and toggle switches -------------------------------------
' One row on its own:
'   $menu_row("clock", "Rittenhistorie")      icon (OpenIconic name), label, chevron > right-aligned
'   $toggle_row("Donkere modus", %true())     label, switch right-aligned (on: dark track, knob right)
' Several rows in one list (less vertical space, use ".." between rows for a subtle line):
'   $list_begin()
'   $menu_item("clock", "Rittenhistorie")
'   ..
'   $toggle_item("Donkere modus", %false())
'   $list_end()
!function $switch($on)
!if $on
!return "<back:#555555><color:#FFFFFF><size:14><U+2002><U+2002>●</size></color></back>"
!else
!return "<back:#DDDDDD><color:#888888><size:14>●<U+2002><U+2002></size></color></back>"
!endif
!endfunction

!procedure $list_begin()
{
!endprocedure

!procedure $menu_item($icon, $label)
  <&$icon> $hs(6)$label | $hs(12)<size:16>></size>
!endprocedure

!procedure $toggle_item($label, $on)
  $label | $switch($on)
!endprocedure

!procedure $list_end()
  $hs(300) | .
}
!endprocedure

!procedure $menu_row($icon, $label)
$list_begin()
$menu_item($icon, $label)
$list_end()
!endprocedure

!procedure $toggle_row($label, $on)
$list_begin()
$toggle_item($label, $on)
$list_end()
!endprocedure

' --- Stats --------------------------------------------------------------------
' $stat_row("Ritten", "12", "Bonuspunten", "128")   two stat tiles side by side (grey label, big value),
'                                                   together full content width; call twice for 2x2
!procedure $stat_row($label1, $value1, $label2, $value2)
{
  {+
    <size:11><color:$muted>$label1</color></size>
    <size:22><b>$value1</b></size>
    $hs(160)
  } | {+
    <size:11><color:$muted>$label2</color></size>
    <size:22><b>$value2</b></size>
    $hs(160)
  }
}
!endprocedure

' --- Several phones in one diagram (popups, variants) ------------------------
' A popup (dialog or bottom sheet) is a SECOND phone next to its screen, in the same file. Popup ids are
' the screen id + a letter (S03a, S07a, S08a, S08b, ...); variants are captioned "S11 – variant A/B".
' Replace the outer "{+ ... }" of the screen by:
'
'   {
'   $phones_begin2("S03 – ReservationScreen", "S03a – bevestiging (dialog)")
'   $phone_top(...)  ...  $phone_bottom(...)        phone 1
'   $phones_next()
'   $phone_top(...)  ...  $phone_bottom(...)        phone 2
'   $phones_end()
'   }
'
' Three phones: $phones_begin3("..", "..", "..") and $phones_next() between each phone.
' Each phone stays 362 x 803 px; phones are 40 px apart with a bold caption above each one.
!procedure $phones_begin2($caption1, $caption2)
<b>$caption1 | $hs(40) | <b>$caption2
{+
!endprocedure

!procedure $phones_begin3($caption1, $caption2, $caption3)
<b>$caption1 | $hs(40) | <b>$caption2 | $hs(40) | <b>$caption3
{+
!endprocedure

!procedure $phones_next()
} | . | {+
!endprocedure

!procedure $phones_end()
}
!endprocedure

' --- Popup content --------------------------------------------------------------
' The popup phone repeats the title bar and bottom navigation of its screen; its content is a grey
' scrim (the dimmed screen) with the dialog or bottom sheet on top of it.
'
' $scrim(150, "overlay op S03")    grey dimmed area of $px high, full content width, with an optional
'                                  small note at its bottom ("" = none). Tune the heights so that
'                                  scrim + dialog + scrim (or scrim + sheet) fill the content area.
!procedure $scrim($px, $note)
{* <size:$px><U+200B></size>$hs(4)<font:monospaced><size:10><color:$muted>$note</color></size></font> }
!endprocedure

' $dialog_begin("Reservering bevestigd") ... $dialog_end()
'     dialog: bold title, content lines, action buttons (e.g. "{ [ Sluiten ] | [ Naar mijn ritten ] }")
!procedure $dialog_begin($title)
{+
  <size:17><b>$title</b></size>
!endprocedure

!procedure $dialog_end()
  $hs($card_width)
}
!endprocedure

' $sheet_begin("Sorteren") ... $sheet_end()
'     bottom sheet: drag handle ─── centered on top, bold title, content; put a $scrim(..) above it
'     so the sheet ends at the bottom of the content area
!procedure $sheet_begin($title)
{+
  $hs(150)<color:#999999><size:16><b>───</b></size></color>
  <size:17><b>$title</b></size>
!endprocedure

!procedure $sheet_end()
  $hs($card_width)
}
!endprocedure

' --- Password strength ---------------------------------------------------------
' $strength(3, "Gemiddeld")        strength bar of 5 blocks (▮▮▮▯▯), $filled dark, plus a label
!function $strength($filled, $label)
!$s = ""
!$i = 1
!while $i <= 5
!if $i <= $filled
!$s = $s + "▮"
!else
!$s = $s + "▯"
!endif
!$i = $i + 1
!endwhile
!return "<size:16>" + $s + "</size> " + $label
!endfunction

' $check(%true(), "Minimaal 8 tekens")   requirement line: ✓ met (black) or ✗ not met (grey)
!function $check($ok, $text)
!if $ok
!return "<b>✓</b> " + $text
!else
!return "<color:#888888><b>✗</b> " + $text + "</color>"
!endif
!endfunction
