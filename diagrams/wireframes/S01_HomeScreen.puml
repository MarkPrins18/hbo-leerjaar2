@startsalt S01_HomeScreen
!include _phone.iuml
title S01 – Wireframe: auto's zoeken (HomeScreen)
{+
$phone_top("Rent my car", %false())
  $section("Filters")
  {
    Max prijs per dag (€)$hs(34) | "                       "
    Max afstand (km)             | "                       "
    Periode start                | "dd-mm-jjjj uu:mm       "
    Periode eind                 | "dd-mm-jjjj uu:mm       "
  }
  [                 Zoeken                  ]
  { <&action-undo> $link("Laatste zoekopdracht") | $muted_text("max € 50, 10 km, 20-11 10:00") }
  ..
  $section("Beschikbare auto's (3)")
  $card_photo_begin()
    <b>Toyota Yaris</b>
    <b>€ 45,00</b> per dag
    $muted_text("<&map-marker> 2,4 km")
  $card_photo_end()
  $card_photo_begin()
    <b>Tesla Model 3</b>
    <b>€ 79,00</b> per dag
    $muted_text("<&map-marker> 5,1 km")
  $card_photo_end()
  $card_photo_begin()
    <b>Hyundai Nexo</b>
    <b>€ 65,00</b> per dag
    $muted_text("<&map-marker> 8,7 km")
  $card_photo_end()
  $note("tik op een auto: S02 CarDetailScreen")
$phone_bottom("Zoeken")
}
legend bottom
  Backendfuncties:
  * carService.getCarMap — GET /cars/map?maxPrice&maxDistanceKm&latitude&longitude&startTime&endTime (#8)
  * photoService.getPhotos — GET /cars/{id}/photos (#4) — eerste foto als thumbnail
  * photoService.getPhotoData — GET /photos/{id} (#4)
  let op: endpoint vereist nu nog login, moet openbaar worden
  afstand: berekend in de app uit latitude/longitude van CarMapResponse en de eigen locatie
  Laatste zoekopdracht: alleen in de app (vorige filters lokaal bewaard en opnieuw ingevuld)
endlegend
@endsalt
