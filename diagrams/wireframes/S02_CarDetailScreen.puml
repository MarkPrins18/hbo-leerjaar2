@startsalt S02_CarDetailScreen
!include _phone.iuml
title S02 – Wireframe: autodetails (CarDetailScreen)
{+
$phone_top("Toyota Yaris", %true())
  $carousel(1, 3)
  { $chip("2021") | $chip("Benzine") | $chip("Automaat") | $chip("5 stoelen") | $chip("5 deuren") }
  $card_begin("Auto")
  {
    Kenteken$hs(93) | AB-123-C
    Uitvoering      | 1.5 Hybrid
    Kleur           | Wit
    Verbruik        | 3,8 l/100 km
    Tankinhoud      | 36 l
  }
  $card_end()
  $card_begin("Huurvoorwaarden")
  {
    Ophalen$hs(88)  | Hoofdstraat 1, Breda
    .               | $muted_text("08:00 - 20:00")
    Inleveren       | Hoofdstraat 1, Breda
    .               | $muted_text("08:00 - 22:00")
  }
  $card_end()
  { <size:18><b>€ 45,00</b></size> per dag$hs(14) | [         Huren          ] }
$phone_bottom("Zoeken")
}
legend bottom
  Backendfuncties:
  * carService.getCarById — GET /cars/{id}
  * photoService.getPhotos — GET /cars/{id}/photos (#4) — foto's in de carrousel
  * photoService.getPhotoData — GET /photos/{id} (#4)
  * rentalTermsService.getRentalTerms — GET /cars/{id}/rental-terms (#5)
  elektrisch: Tankinhoud wordt Accucapaciteit (kWh), waterstof: Tankinhoud (kg H2); Automaat alleen bij brandstof
  [Huren]: niet ingelogd eerst S04 LoginScreen, daarna S03 ReservationScreen
endlegend
@endsalt
