@startsalt S11_CarFormScreen
!include _phone.iuml
title S11 – Wireframe: auto toevoegen en gegevens (CarFormScreen)

' Compact photo carousel with a "+" tile on the right for adding a photo.
!procedure $carousel_add($page, $total)
!$dots = ""
!$i = 1
!while $i <= $total
!if $i == $page
!$dots = $dots + "●"
!else
!$dots = $dots + "○"
!endif
!if $i < $total
!$dots = $dots + " "
!endif
!$i = $i + 1
!endwhile
{
  {+
    {
      {
        <size:36><U+200B></size>
        $hs(2)<size:22><b>‹</b></size>
      } | {
        <size:8><U+200B></size>
        $hs(52)<color:$grey_icon><&image*10></color>
      } | {
        <size:36><U+200B></size>
        $hs(54)<size:22><b>›</b></size>
      }
    }
    { $hs(80)<size:12>$dots</size> | $hs(40)<color:$muted>$page/$total }
    $hs(236)
  } | {+
    <size:22><U+200B></size>
    $hs(26)<size:30><b>+</b></size>
    $hs(8)Foto
    $hs(4)toevoegen
    <size:22><U+200B></size>
    $hs(82)
  }
}
!endprocedure

{
$phones_begin2("S11 – variant A: auto toevoegen", "S11 – variant B: gegevens (na goedkeuring of via Bewerken)")
$phone_top("Auto toevoegen", %true())
  $section("Stap 1 – kenteken controleren")
  Kenteken
  "AB-123-C                                 "
  Aandrijving
  { $chip_dark("Brandstof") | $chip("Elektrisch") | $chip("Waterstof") }
  {
    Tankinhoud (l)        | "36                     "
    Automaat$hs(86)       | [X]
  }
  $note("verplicht voor de RDW-import, velden wisselen per aandrijving")
  .
  [           Controleren bij RDW           ]
  .
  $card_begin("")
    { <b>✓ Goedgekeurd</b>$hs(150) | $chip_dark("RDW") }
    Toyota Yaris $muted_text("· 2021 · Wit")
    $muted_text("Benzine · 1165 kg rijklaar · Personenauto")
  $card_end()
  $note("auto is aangemaakt, verder naar variant B")
  ..
  $section("Afgekeurd (voorbeelden)")
  $muted_text("✗ Dit kenteken is al geregistreerd")
  $muted_text("✗ Geen voertuig gevonden bij de RDW")
  $muted_text("✗ Geen Nederlands kenteken (bijv. AB-123-C)")
$phone_bottom("Account")
$phones_next()
$phone_top("Toyota Yaris", %true())
  $carousel_add(1, 3)
  { [ <&map-marker> Auto staat hier ] | $muted_text("51.5890, 4.7760") }
  $note("locatie via GPS van de telefoon")
  $section("Auto")
  {
    Kenteken$hs(93)    | "AB-123-C               "
    Merk               | "Toyota                 "
    Model              | "Yaris                  "
    Uitvoering         | "1.5 Hybrid             "
    Bouwjaar           | "2021                   "
    Kleur              | "Wit                    "
  }
  $section("Aandrijving")
  {
    Brandstof$hs(93)   | ^Benzine              ^
    Tankinhoud (l)     | "36                     "
    Verbruik (l/100 km)| "3,8                    "
    Automaat           | [X]
  }
  $section("Overig")
  {
    Voertuigsoort$hs(73) | ^Personenauto         ^
  }
  { Stoelen / deuren$hs(55) | "5         " | "5         " }
  $note("scrollt verder: gewicht rijklaar, CO2-uitstoot, wegenbelasting")
  [                 Opslaan                 ]
$phone_bottom("Account")
$phones_end()
}
legend bottom
  Backendfuncties:
  * carImportService.importCar — POST /cars/import (#3) — [Controleren bij RDW]: haalt de auto op bij de RDW en maakt hem direct aan
    CarDto: kenteken + verplicht per aandrijving tankCapacityL en automaticTransmission (brandstof), batteryCapacityKWh (elektrisch)
    of tankCapacityKgH2 (waterstof); optioneel trim, consumptionCombined, roadTaxPerQuarter
    afgekeurd: kenteken al geregistreerd (409), niet gevonden of niet-ondersteunde brandstof bij de RDW (422), ongeldig kenteken (400)
  * carService.getCarByLicensePlate — GET /cars/license-plate/{licensePlate} (#3) — zoekt in de eigen database, niet bij de RDW;
    optionele voorcontrole "al geregistreerd"
  * carService.updateCar — PATCH /cars/{id} (#3) — [Opslaan] met CarChangeDto, alleen gewijzigde velden; daarna S10
  * locationService.setLocation — PUT /cars/{id}/location (#3) — [Auto staat hier]: latitude/longitude van de GPS van de telefoon
  * photoService.uploadPhoto — POST /cars/{id}/photos (#4) — "+" tegel, multipart veld "photo", max 5 MB
  * photoService.getPhotos — GET /cars/{id}/photos (#4) en photoService.getPhotoData — GET /photos/{id} (#4)
  geen endpoint (nog uit te werken): RDW-controle zonder de auto aan te maken; aandrijving kiezen vóór de import: alleen in de app
  variant B: velden per type (brandstof: brandstof, tankinhoud, automaat; elektrisch: accucapaciteit kWh; waterstof: tankinhoud kg H2)
endlegend
@endsalt
