' Empty row between two rows of phones.
!procedure $phones_row_gap()
<size:24><U+200B></size> | . | . | . | .
!endprocedure

{
$phones_begin3("S08 – AccountScreen", "S08a – account (dialog)", "S08b – probleem melden (dialog)")
$phone_top("Account", %false())
  $card_begin("")
    { <color:$grey_icon><&person*4></color> | $hs(4) | {
      <b>jan@voorbeeld.nl</b>
      $muted_text("Gegevens wijzigen")
    } | $hs(168)<size:16>></size> }
  $card_end()
  $note("tik op de kaart: S08a")
