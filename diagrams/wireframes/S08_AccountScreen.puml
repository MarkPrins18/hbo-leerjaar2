  $scrim(156, "")
$phone_bottom("Account")
$phones_next()
$phone_top("Account", %false())
  $scrim(92, "overlay op S08 (vanuit S08a)")
  $dialog_begin("Wachtwoord wijzigen")
    ..
    Huidig wachtwoord
    $password_field(%false())
    Nieuw wachtwoord
    $password_field(%true(), "Geheim123")
    Herhaal nieuw wachtwoord
    $password_field(%false())
    .
    { Sterkte$hs(40) | $strength(3, "Gemiddeld") }
    $check(%true(), "Minimaal 8 tekens")
    $check(%true(), "Een hoofdletter")
    $check(%true(), "Een kleine letter")
    $check(%true(), "Een cijfer")
    $check(%false(), "Een speciaal teken (bijv. ! of #)")
    $check(%true(), "Wachtwoorden zijn gelijk")
    .
    { [     Annuleren    ] | [      Opslaan       ] }
  $dialog_end()
  $scrim(92, "")
$phone_bottom("Account")
$phones_next()
$phone_top("Account", %false())
  $scrim(156, "overlay op S08 (vanuit S08a)")
  $dialog_begin("Account verwijderen")
    ..
    Je account wordt definitief verwijderd.
    Dit kan niet ongedaan worden gemaakt.
    $muted_text("Niet mogelijk tijdens een reservering of rit.")
    .
    Wachtwoord (ter bevestiging)
    $password_field(%false())
    .
    { [     Annuleren    ] | [    Verwijderen     ] }
  $dialog_end()
  $scrim(156, "")
$phone_bottom("Account")
$phones_end()
}
legend bottom
  Backendfuncties:
  * userService.getUserResponse — GET /users/me (#13) — e-mailadres en bonuspunten (saldo)
  * carService.getCarsByOwner — GET /cars/mine — aantal bij "Mijn auto's"
  * rideService.getRides — GET /rides (#13) — aantal ritten en afgeronde ritten
  S08a account: User heeft alleen id, email en passwordHash; bonuspunten = som van afgeronde ritten (niet te wijzigen)
  S08a1 e-mailadres wijzigen: geen endpoint (nog uit te werken); zelfde e-mailcheck als registreren, bestaat al = 409,
    het token bevat de e-mail (claim) dus daarna opnieuw inloggen
  S08a2 wachtwoord wijzigen: geen endpoint (nog uit te werken); eisen = RegisterRequest.validate (minimaal 8 tekens,
    hoofdletter, kleine letter, cijfer, speciaal teken, maximaal 72 bytes); sterkte en herhaling alleen in de app
  S08a3 account verwijderen: geen endpoint (nog uit te werken); car, reservation en location verwijzen naar users
  S08b probleem melden: geen endpoint (nog uit te werken); bugs, crashes en suggesties voor de ontwikkelaars
  S08a [Sluiten] en S08b [Annuleren]/[Versturen]: terug naar S08; S08a1–S08a3 [Annuleren]/[Opslaan]: terug naar S08a,
    S08a3 [Verwijderen]: uitgelogd, naar S01
  Donkere modus en uitloggen (token weg): alleen in de app
endlegend
@endsalt
