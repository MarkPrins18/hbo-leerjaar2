$phone_bottom("Account")
$phones_next()
$phone_top("Account", %false())
  $scrim(113, "overlay op S08")
  $dialog_begin("Probleem melden")
    $muted_text("Voor de ontwikkelaars: fouten en ideeën over de app")
    ..
    Soort probleem
    { $chip_dark("Bug") | $chip("Crash") | $chip("Suggestie") | $chip("Anders") }
    Korte omschrijving
    "Kaart laadt niet bij Route              "
    Wat gebeurde er? (stappen)
    {+
      1. Rit gestart  2. Tik op Route
      3. Scherm blijft wit
      <size:40><U+200B></size>
      $hs(320)
    }
    $note("app-versie en toestel worden automatisch meegestuurd")
    .
    { [     Annuleren    ] | [     Versturen      ] }
  $dialog_end()
  $scrim(113, "")
$phone_bottom("Account")
$phones_end()
$phones_row_gap()
$phones_begin3("S08a1 – e-mailadres wijzigen (dialog)", "S08a2 – wachtwoord wijzigen (dialog)", "S08a3 – account verwijderen (dialog)")
$phone_top("Account", %false())
  $scrim(155, "overlay op S08 (vanuit S08a)")
  $dialog_begin("E-mailadres wijzigen")
    $muted_text("Huidig: jan@voorbeeld.nl")
    ..
