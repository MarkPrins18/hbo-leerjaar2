  $menu_row("key", "Mijn auto's (2)")
  $section("Ritten")
  $menu_row("clock", "Rittenhistorie (12)")
  $section("Bonuspunten")
  $stat_row("Saldo", "128", "Afgeronde ritten", "12")
  .
  [                Uitloggen                ]
  ..
  $menu_row("bug", "Probleem melden")
  $note("Mijn auto's: S10 · Rittenhistorie: S09 · Probleem melden: S08b")
$phone_bottom("Account")
$phones_next()
$phone_top("Account", %false())
  $scrim(147, "overlay op S08")
  $dialog_begin("Account")
    $muted_text("jan@voorbeeld.nl")
    ..
    $list_begin()
    $menu_item("envelope-closed", "E-mailadres wijzigen")
    ..
    $menu_item("lock-locked", "Wachtwoord wijzigen")
