package "shared" #E8E0F5 {
    class SharedModels <<file>> {
        shared.models
        --
        Car (ICE / BEV / FCEV), Photo
        RentalTerms, Reservation, Ride
    }
    class SharedDto <<file>> {
        shared.dto
        --
        CarDto, CarChangeDto
        RentalTermsRequest, RideFinishRequest
    }
    class SharedRequests <<file>> {
        shared.requests
        --
        LoginRequest, RegisterRequest
        ReservationRequest
    }
    class SharedResponses <<file>> {
        shared.responses
        --
        LoginResponse, UserResponse
        FuelCostResponse, TcoResponse
        ErrorResponse
    }
}

package "composeApp" #E8E0F5 {
    class App <<file>> {
        +App()
    }
}

package "androidApp" #E8E0F5 {
    class MainActivity <<file>>
}

package "routes" #DCEBFA {
    class CarRouting <<file>> {
        +carRoutes(carService, carImportService, carCostService)
        --
        GET /cars
        GET /cars/{id}
        GET /cars/license-plate/{licensePlate}
        <&lock-locked> GET /cars/mine
        <&lock-locked> POST /cars/import
        <&lock-locked> PATCH /cars/{id}
        <&lock-locked> DELETE /cars/{id}
        <&lock-locked> GET /cars/{id}/fuel-cost
        <&lock-locked> GET /cars/{id}/tco
        <&lock-locked> POST /cars/{id}/cost-data
    }
    class PhotoRouting <<file>> {
        +photoRoutes(photoService)
        --
        <&lock-locked> POST /cars/{id}/photos
        GET /cars/{id}/photos
        GET /photos/{id}
    }
    class RentalTermsRouting <<file>> {
        +rentalTermsRoutes(rentalTermsService)
        --
        GET /cars/{id}/rental-terms
        <&lock-locked> PUT /cars/{id}/rental-terms
    }
    class MapRouting <<file>> {
        +mapRoutes(locationService)
        --
        <&lock-locked> GET /cars/{carId}/maps
    }
    class ReservationRouting <<file>> {
        +reservationRoutes(reservationService)
        --
        <&lock-locked> GET /reservations
        <&lock-locked> POST /reservations
        <&lock-locked> PATCH /reservations/{id}/cancel
    }
    class RideRouting <<file>> {
        +rideRoutes(rideService)
        --
        <&lock-locked> POST /reservations/{id}/rides
        <&lock-locked> GET /rides/active
        <&lock-locked> PATCH /rides/{id}/finish
    }
    class UserRouting <<file>> {
        +userRoutes(userService, authService)
        --
        GET /users
        POST /users/register
        POST /users/login
        <&lock-locked> GET /users/me
    }
}

package "services" #DDF2DD {
    class PhotoService <<service>> {
        +uploadPhoto(carId, userId, data): Photo
        +getPhotos(carId): List<Photo>
        +getPhotoData(photoId): ByteArray
    }
    class CarService <<service>> {
        +getCars(filter): List<Car>
        +getCarById(carId): Car
        +getCarsByOwner(userId): List<Car>
        +getCarByLicensePlate(licensePlate): Car
        +updateCar(carId, userId, change): Car
        +deleteCar(carId, userId)
    }
    class CarImportService <<service>> {
        +importCar(request, userId): Car
    }
    class CarCostService <<service>> {
        +fillMissingCostData(carId, userId): Car
        +getFuelCost(carId, userId, distanceKm): FuelCostResponse
        +getTco(carId, userId, annualKm): TcoResponse
    }
    class RentalTermsService <<service>> {
        +getRentalTerms(carId): RentalTerms
        +setRentalTerms(carId, userId, request): RentalTerms
    }
    class LocationService <<service>> {
        +getMapsUrl(carId, userId): String
    }
    class ReservationService <<service>> {
        +createReservation(userId, request): Reservation
        +getReservationsForUser(userId): List<Reservation>
        +cancelReservation(id, userId): Reservation
    }
    class RideService <<service>> {
        +startRide(reservationId, userId): Ride
        +getActiveRide(userId): Ride?
        +finishRide(rideId, userId, request): Ride
    }
    class UserService <<service>> {
        +register(request): User
        +getUser(userId): User
        +getAllUsers(): List<User>
    }
    together {
        class AuthService <<service>> {
            +login(request): String
        }
        class TokenService <<service>> {
            +createToken(user): String
        }
    }
    class Helpers <<file>> {
        CarValidation / UserValidation
        CarLookup (getOwnedCar, callExternal)
        CarFilterMatching / Distance
        FuelCost / TotalCostOfOwnership
        BonusPoints
    }
}


package "clients" #F7DEE6 {
    interface VehicleRegistry {
        +getVehicle(licensePlate): RdwVehicleDto?
        +getFuel(licensePlate): List<RdwFuelDto>
    }
    interface CostEstimator {
        +estimateCarCosts(car): CarCostEstimate
    }
    class RdwClient {
        extends JsonApiClient
        HTTPS → RDW Open Data
    }
    class GeminiClient {
        extends JsonApiClient
        HTTPS → Google Gemini
    }
}

package "config" #ECECEC {
    class PhotoStorage {
        +save(fileName, bytes)
        +read(fileName): ByteArray?
        +delete(fileName)
    }
}

package "repositories" #FFF1D6 {
    interface CarRepository {
        +getAllCars(): List<Car>
        +getCarById(carId): Car?
        +getCarByLicensePlate(licensePlate): Car?
        +getCarsByUserId(userId): List<Car>
        +createCar(car): Car
        +updateCar(carId, change): Car?
        +deleteCar(carId): Boolean
    }
    interface PhotoRepository {
        +createPhoto(carId, fileName): Photo
        +getPhotosByCarId(carId): List<Photo>
        +getFileName(photoId): String?
        +getFileNamesByCarId(carId): List<String>
    }
    interface RentalTermsRepository {
        +carExists(carId): Boolean
        +getRentalTermsByCarId(carId): RentalTerms?
        +saveRentalTerms(carId, request): RentalTerms
    }
    interface LocationRepository {
        +getLatestLocationByCarId(carId): Location?
    }
    interface ReservationRepository {
        +userExists(userId): Boolean
        +createReservationIfAvailable(carId, userId, startTime, endTime, status): Reservation?
        +getReservationById(id): Reservation?
        +getReservationsByCarAndUser(carId, userId): List<Reservation>
        +getReservationsByUserId(userId): List<Reservation>
        +updateStatus(id, status): Reservation?
    }
    interface RideRepository {
        +startRideIfNoneInProgress(reservationId, startTime): Ride?
        +getRideById(rideId): Ride?
        +getRideInProgressByUserId(userId): Ride?
        +finishRide(id, endTime, distanceM, ...): Ride?
    }
    interface UserRepository {
        +findByEmail(email): User?
        +findById(userId): User?
        +findAll(): List<User>
        +userExists(userId): Boolean
        +create(email, passwordHash): User
    }

    note "Elke interface wordt geïmplementeerd door\n<b>Exposed<Naam>Repository</b> (Exposed + H2)" as ExposedNote
}

