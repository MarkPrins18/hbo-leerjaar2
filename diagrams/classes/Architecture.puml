CarImportService --> UserRepository
CarImportService --> VehicleRegistry
CarCostService --> CarRepository
CarCostService --> CostEstimator
PhotoService --> PhotoRepository
PhotoService --> CarRepository
PhotoService --> PhotoStorage
RentalTermsService --> RentalTermsRepository
RentalTermsService --> CarRepository
LocationService --> CarRepository
LocationService --> LocationRepository
LocationService --> ReservationRepository
ReservationService --> ReservationRepository
RideService --> RideRepository
RideService --> ReservationRepository
