@startuml Architecture

skinparam packageStyle rectangle

package routes {
    class CarRouting <<file>> {
        +carRoutes(carService, carImportService, carCostService)
    }
    class PhotoRouting <<file>> {
        +photoRoutes(photoService)
    }
    class MapRouting <<file>> {
        +mapRoutes(locationService)
    }
    class RentalTermsRouting <<file>> {
        +rentalTermsRoutes(rentalTermsService)
    }
    class ReservationRouting <<file>> {
        +reservationRoutes(reservationService)
    }
    class RideRouting <<file>> {
        +rideRoutes(rideService)
    }
    class UserRouting <<file>> {
        +userRoutes(userService, authService)
    }
}

package services {
    class CarService {
        +getCars(filter): List<Car>
        +getCarById(carId): Car
        +getCarByLicensePlate(licensePlate): Car
        +updateCar(carId, userId, change): Car
        +deleteCar(carId, userId)
    }
    class CarImportService {
        +importCar(request, userId): Car
    }
    class CarCostService {
        +getFuelCost(carId, userId, distanceKm): FuelCostResponse
        +getTco(carId, userId, annualKm): TcoResponse
        +fillMissingCostData(carId, userId): Car
    }
    class PhotoService {
        +uploadPhoto(carId, userId, data): Photo
        +getPhotos(carId): List<Photo>
        +getPhotoData(photoId): ByteArray
    }
    class RentalTermsService {
        +getRentalTerms(carId): RentalTerms
        +setRentalTerms(carId, userId, request): RentalTerms
    }
    class LocationService {
        +getMapsUrl(carId, userId): String
    }
    class ReservationService {
        +createReservation(userId, request): Reservation
        +cancelReservation(id, userId): Reservation
    }
    class RideService {
        +startRide(reservationId, userId): Ride
        +finishRide(rideId, userId, request): Ride
    }
    class UserService {
        +register(request): User
        +getAllUsers(): List<User>
    }
    class AuthService {
        +login(request): String
    }
    class TokenService {
        +createToken(user): String
        +verifier
    }
}

package repositories {
    interface CarRepository {
        +getAllCars()
        +getCarById(carId)
        +getCarByLicensePlate(licensePlate)
        +createCar(car)
        +updateCar(carId, change)
        +deleteCar(carId)
    }
    interface LocationRepository {
        +getLatestLocationByCarId(carId)
    }
    interface PhotoRepository {
        +createPhoto(carId, fileName)
        +getPhotosByCarId(carId)
        +getFileName(photoId)
        +getFileNamesByCarId(carId)
    }
    interface RentalTermsRepository {
        +carExists(carId)
        +getRentalTermsByCarId(carId)
        +saveRentalTerms(carId, request)
    }
    interface ReservationRepository {
        +carExists(carId)
        +userExists(userId)
        +hasActiveOverlap(carId, startTime, endTime)
        +createReservation(...)
        +getReservationById(id)
        +getReservationsByCarAndUser(carId, userId)
        +updateStatus(id, status)
    }
    interface RideRepository {
        +hasRideInProgress(reservationId)
        +startRide(reservationId, startTime)
        +getRideById(rideId)
        +finishRide(...)
    }
    interface UserRepository {
        +findByEmail(email)
        +findAll()
        +userExists(userId)
        +create(email, passwordHash)
    }

    class ExposedCarRepository
    class ExposedLocationRepository
    class ExposedPhotoRepository
    class ExposedRentalTermsRepository
    class ExposedReservationRepository
    class ExposedRideRepository
    class ExposedUserRepository

    CarRepository <|.. ExposedCarRepository
    LocationRepository <|.. ExposedLocationRepository
    PhotoRepository <|.. ExposedPhotoRepository
    RentalTermsRepository <|.. ExposedRentalTermsRepository
    ReservationRepository <|.. ExposedReservationRepository
    RideRepository <|.. ExposedRideRepository
    UserRepository <|.. ExposedUserRepository
}

package clients {
    interface VehicleRegistry {
        +getVehicle(licensePlate)
        +getFuel(licensePlate)
    }
    interface CostEstimator {
        +estimateCarCosts(car)
    }
    abstract class JsonApiClient
    class RdwClient <<external>>
    class GeminiClient <<external>>

    VehicleRegistry <|.. RdwClient
    CostEstimator <|.. GeminiClient
    JsonApiClient <|-- RdwClient
    JsonApiClient <|-- GeminiClient
}

package config {
    class PhotoStorage {
        +save(fileName, bytes)
        +read(fileName)
        +delete(fileName)
    }
}

CarRouting --> CarService
CarRouting --> CarImportService
CarRouting --> CarCostService
PhotoRouting --> PhotoService
MapRouting --> LocationService
RentalTermsRouting --> RentalTermsService
ReservationRouting --> ReservationService
RideRouting --> RideService
UserRouting --> UserService
UserRouting --> AuthService

CarService --> CarRepository
CarService --> LocationRepository
CarService --> PhotoRepository
CarService --> RentalTermsRepository
CarService --> PhotoStorage
CarImportService --> VehicleRegistry
CarImportService --> CarRepository
CarImportService --> UserRepository
CarCostService --> CostEstimator
CarCostService --> CarRepository
PhotoService --> PhotoRepository
PhotoService --> CarRepository
PhotoService --> PhotoStorage
RentalTermsService --> RentalTermsRepository
RentalTermsService --> CarRepository
LocationService --> CarRepository
LocationService --> LocationRepository
LocationService --> ReservationRepository
ReservationService --> ReservationRepository
RideService --> RideRepository
RideService --> ReservationRepository
UserService --> UserRepository
AuthService --> UserRepository
AuthService --> TokenService

@enduml
